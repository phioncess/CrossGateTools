    "lineCount": 13,
    "rawLines": [
      {
        "line": 1,
        "text": "1.前往亚诺曼城与白金礼包贩售员（131.131）对话，交出2000G购买【白金礼包】。"
      },
      {
        "line": 2,
        "text": "◆在2、3线购买【白金礼包】时谨防与NPC位置重叠的“骗子”摊位"
      },
      {
        "line": 3,
        "text": "2.双击【白金礼包】随机获得【奖品】，任务完结。"
      },
      {
        "line": 4,
        "text": "◆【奖品】明细："
      },
      {
        "line": 5,
        "text": "宠物类奖品（随机获得）备注"
      },
      {
        "line": 6,
        "text": "“不明物”灵魂容器（黑色露比形象）；10技能栏、人形系；4种：风100；25 6 31 17 46地100；26 7 33 12 47水100；27 5 32 16 45火100；24 8 30 15 48"
      },
      {
        "line": 7,
        "text": "食尸鬼设计图（A~E）暴食鬼；9技能栏；不死系火70风30；39 40 15 16 15"
      },
      {
        "line": 8,
        "text": "红帽哥布林设计图（A~E）哥布林队长；8技能栏；人形系水100；35 40 20 20 10"
      },
      {
        "line": 9,
        "text": "其他奖品（随机获得）"
      },
      {
        "line": 10,
        "text": "传送石优待券鼠王还原券"
      },
      {
        "line": 11,
        "text": "阿尔卡迪亚古钱魔石（2种）"
      },
      {
        "line": 12,
        "text": "技能学习证Lv.9 宝石（8种）"
      },
      {
        "line": 13,
        "text": "哥拉尔镇/阿凯鲁法村/雷克塔尔镇传送券神奇的药草（200技能经验）"
      }
    ]
  },
