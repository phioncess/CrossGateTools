  "segments": [
    {
      "line": 1,
      "text": "1.前往斯特隆海姆城议事厅（34.34）与辅佐官（12.4）对话，获得【调查证明】。",
      "type": "step",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "2.前往雷克亚克平原（209.231）处与伤员对话，交出【调查证明】获得【证词一】。",
      "type": "exchange-step",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "3.返回斯特隆海姆城与老海员（27.41）对话，交出【证词一】获得【调查书】。",
      "type": "exchange-step",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "4.前往议事厅（34.34）2楼与管理官（18.6）对话，交出【调查书】获得【海岛调查信】。",
      "type": "exchange-step",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "◆进行到此步若人物身上存在【调查证明】，请丢弃【调查证明】后对话，否则不能获得【海岛调查信】",
      "type": "inventory-gate",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "5.前往雷克亚克平原（176.242）处与调查队员对话，交出【海岛调查信】获得【卫兵的求助信】。",
      "type": "exchange-step",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "◆雷克亚克平原地图：",
      "type": "media-caption",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "6.前往魔法大学与爽朗的法师（88.139）对话，交出【卫兵的求助信】获得【结界水晶】。",
      "type": "exchange-step",
      "sourceLines": [
        8
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 9,
      "text": "7.返回雷克亚克平原（176.242）处与调查队员对话，通过（185.247）处传送石进入扭曲的灯塔。",
      "type": "maze-entry",
      "sourceLines": [
        9
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "◆扭曲的灯塔为随机迷宫，约10层；",
      "type": "maze-detail",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 11,
      "text": "魔物为Lv49~54死灵、鸟人、土蜘蛛；击倒魔物后会随机掉落【漂亮的羽毛】",
      "type": "drop-rule",
      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "8.通过随机迷宫至扭曲的灯塔底层，与疯狂的女飞翼酋长对话进入战斗。",
      "type": "battle-step",
      "sourceLines": [
        12
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 13,
      "text": "◆战斗信息：",
      "type": "battle-heading",
      "sourceLines": [
        13
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 14,
      "text": "Lv.60疯狂的女飞翼酋长（2动），血量约10000；技能：攻击、防御、连击、超强风刃魔法、乾坤一掷",
      "type": "battle-enemy",
      "sourceLines": [
        14
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 15,
      "text": "Lv.55飞翼护卫*4（1动），血量约2300；技能：攻击、防御、吸血魔法、火焰魔法",
      "type": "battle-enemy",
      "sourceLines": [
        15
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 16,
      "text": "9.战斗胜利后与调查队员对话，交出【结界水晶】获得【灯塔报告】并传送出扭曲的灯塔。",
      "type": "exchange-step",
      "sourceLines": [
        16
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 17,
      "text": "10.返回斯特隆海姆城议事厅（34.34）2楼与管理官（18.7）对话，交出【灯塔报告】获得【舒适的皮鞋】或【舒适的长靴】，任务完结。",
      "type": "completion-step",
      "sourceLines": [
        17
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 18,
      "text": "◆ 持有10根【漂亮的羽毛】与管理官对话可兑换【舒适的皮鞋】或【舒适的长靴】",
      "type": "post-quest-exchange",
      "sourceLines": [
        18
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 19,
      "text": "◆【舒适的皮鞋】：Lv.6鞋、耐久200；防御+17~23、敏捷+25~30、精神+3~5、命中+6~8；数值浮动范围仍待完善、可以交易",
      "type": "reward-detail",
      "sourceLines": [
        19
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 20,
      "text": "◆【舒适的长靴】：Lv.6靴、耐久200；防御+45~65、敏捷+5~8、命中+5~10、抗魔+15~30；数值浮动范围仍待完善、可以交易",
      "type": "reward-detail",
      "sourceLines": [
        20
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 21,
      "text": "◆ 任务完结后不可重复解，但可再进入扭曲的灯塔和陪打",
      "type": "repeat-rule",
      "sourceLines": [
        21
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    }
  ],
