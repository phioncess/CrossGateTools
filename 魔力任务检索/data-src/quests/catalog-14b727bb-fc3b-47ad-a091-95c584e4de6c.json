    "localFiles": [],
    "lineCount": 17,
    "rawLines": [
      {
        "line": 1,
        "text": "中秋节活动《中秋节赏月公园》"
      },
      {
        "line": 2,
        "text": "【兔子王的胡萝卜】路线："
      },
      {
        "line": 3,
        "text": "1.前往亚诺曼城（191.158）处与赏月公园负责人对话，选2次“是”传送至中秋节赏月公园。"
      },
      {
        "line": 4,
        "text": "2.与兔子王（105.24）对话，选“是”交出200G获得【兔子王的胡萝卜】并传送出中秋节赏月公园，任务完结。"
      },
      {
        "line": 5,
        "text": "◆【兔子王的胡萝卜】："
      },
      {
        "line": 6,
        "text": "双击，选“是”人物造型变为围巾兔并打卡，"
      },
      {
        "line": 7,
        "text": "选“否”人物保持原样并打卡，"
      },
      {
        "line": 8,
        "text": "选“取消”则人物保持原因并不打卡。"
      },
      {
        "line": 9,
        "text": "不可叠加、可交易。"
      },
      {
        "line": 10,
        "text": "中秋节活动《每日礼品领取》"
      },
      {
        "line": 11,
        "text": "【月饼】路线："
      },
      {
        "line": 12,
        "text": "1.前往法兰城（95.83）处与中秋节工作员对话，选“是”获得【巧克力月饼】、【蛋黄月饼】、【新口味五仁月饼】，任务完结。"
      },
      {
        "line": 13,
        "text": "◆等级低于Lv.20无法领取【月饼】；"
      },
      {
        "line": 14,
        "text": "◆【月饼】每日只可领取1次，0点重置；【月饼】不可交易、丢地消失"
      },
      {
        "line": 15,
        "text": "◆【巧克力月饼】：使用后恢复生命值250点"
      },
      {
        "line": 16,
        "text": "◆【蛋黄月饼】：使用后恢复魔法值200点"
      },
      {
        "line": 17,
        "text": "◆【新口味五仁月饼】：使用后随机增加技能经验值200点"
      }
    ]
  },
