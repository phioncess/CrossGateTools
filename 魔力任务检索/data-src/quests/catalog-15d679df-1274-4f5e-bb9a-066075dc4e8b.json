        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "◆本任务获得的未鉴定物品无需鉴定，鉴定后也可交出",
      "type": "unidentified-item-rule",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "◆本任务仅女性角色可完成；若想成为男性护士，见本任务最后破解方法",
      "type": "gender-gate",
      "sourceLines": [
        3
