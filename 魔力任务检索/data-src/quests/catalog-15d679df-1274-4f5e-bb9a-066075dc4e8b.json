        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "5.白天，前往法兰城（149~157.122~155），寻找护士乔斯琪并与之对话，获得【诊断书】。",
      "type": "item-acquisition",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
