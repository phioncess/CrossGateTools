  "segments": [
    {
      "line": 1,
      "text": "抽奖活动：",
      "type": "section-heading",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "1.前往法兰城里谢里雅堡与圣诞兔女郎(40.78)对话，交出200G购买【空袜子】。",
      "type": "purchase-step",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "2.现实时间23小时后与圣诞兔女郎对话，交出【空袜子】随机获得奖励。",
      "type": "timed-random-reward",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "◆奖品明细（随机获得）：圣诞拐棍糖、圣诞火鸡、圣诞香草、圣诞鼠王娃娃、冰雪结晶、圣诞精灵精华、圣诞波波精华",
      "type": "reward-list",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "任务活动：",
      "type": "section-heading",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "前往法兰城里谢里雅堡与嘉年华活动员（42.78）对话进入圣诞嘉年华活动会场。",
      "type": "event-entry",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "◆下列各路线中获得的【冰雪结晶】可用于兑换奖品",
      "type": "exchange-purpose",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "◆奖品明细：",
      "type": "reward-heading",
      "sourceLines": [
        8
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 9,
      "text": "圣诞拐棍糖、圣诞火鸡、圣诞香草、圣诞鼠王娃娃、冰雪结晶、圣诞精灵精华、圣诞波波精华",
      "type": "reward-list",
      "sourceLines": [
        9
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "猜谜路线：",
      "type": "route-heading",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 11,
      "text": "与睿智的维斯（41.45）对话，选“是”获得【谜语1-5】，输入答案获得【冰雪结晶】*5。",
      "type": "riddle-route",
      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "食材路线：",
      "type": "route-heading",
      "sourceLines": [
        12
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 13,
      "text": "与大厨师（28.20）对话，交出【小麦粉】*20、【牛奶】*20获得【冰雪结晶】*10。",
      "type": "material-exchange",
      "sourceLines": [
        13
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 14,
      "text": "战斗路线：",
      "type": "route-heading",
      "sourceLines": [
        14
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 15,
      "text": "①.与雪地行者卢克（63.21）对话选择是进入冰雪迷宫。",
      "type": "maze-entry",
      "sourceLines": [
        15
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 16,
      "text": "◆冰雪迷宫为随机迷宫；魔物为Lv.49~54冰冷树精、水蓝鸟魔、北极熊、猫妖",
      "type": "encounter-area",
      "sourceLines": [
        16
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 17,
      "text": "②.通过随机迷宫至迷宫底部与雪地行者卢克对话进入战斗。",
      "type": "battle-step",
      "sourceLines": [
        17
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 18,
      "text": "◆Lv.60圣诞波波*3、圣诞精灵*2",
      "type": "battle-enemy",
      "sourceLines": [
        18
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 19,
      "text": "③.战斗胜利后与雪地行者卢克对话，获得【冰雪结晶】*30并传送回圣诞嘉年华活动会场。",
      "type": "route-reward",
      "sourceLines": [
        19
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 20,
      "text": "跑腿路线：",
      "type": "route-heading",
      "sourceLines": [
        20
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 21,
      "text": "①.与勤劳的莱玛（57.61）对话，选“是”获得【圣拉鲁卡物资】、【维诺亚物资】。",
      "type": "item-acquisition",
      "sourceLines": [
        21
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 22,
      "text": "②.与圣拉鲁卡村工作人员（42.63）对话，交出【圣拉鲁卡物资】，获得【冰雪结晶】*10。",
      "type": "exchange-step",
      "sourceLines": [
        22
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 23,
      "text": "③.与维诺亚村工作人员（53.51）对话，交出【维诺亚物资】获得【冰雪结晶】*10。",
      "type": "exchange-step",
      "sourceLines": [
        23
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    }
