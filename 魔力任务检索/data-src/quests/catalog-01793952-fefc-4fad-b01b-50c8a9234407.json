  "name": "庆生蛋糕",
  "aliases": [],
  "metadata": {
    "category": "临时活动/任务",
    "level": "60 级",
    "availability": "closed",
    "summary": "怀旧服任务（已关闭）；以下仅展示怀旧服路线与参数",
