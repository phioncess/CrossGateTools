  "segments": [
    {
      "line": 1,
      "text": "1.前往法兰城里谢里雅堡与蛋糕师库洛斯（41.76）对话，选“是”获得【蛋糕的配方】。",
      "type": "step",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "2.前往相关村落用相关物品兑换【蛋糕的配方】所需物品。",
      "type": "collection-step",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "◆兑换无需按顺序：",
      "type": "order-rule",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "前往伊尔村旧金山酒吧与鲜奶的助手（20.22）对话，交出6个【高级奶油】获得【鲜奶油】",
      "type": "exchange-row",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "前往圣拉鲁卡村赛杰利亚酒吧与寻找布丁的助手（9.7）对话，交出6个【番红花】获得【布丁】",
      "type": "exchange-row",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "前往亚留特村村长的家与寻找樱桃的助手（20.8）对话，交出1个【生命回复药（400）】获得【樱桃】",
      "type": "exchange-row",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "前往维诺亚村荷特尔咖喱店与寻找奶酪的助手（12.11）对话，交出1个【炒面面包】获得【奶酪】",
      "type": "exchange-row",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "前往奇利村酒吧与寻找果酱的助手（12.9）对话，交出6个【白金（矿）】获得【果酱】",
      "type": "exchange-row",
      "sourceLines": [
        8
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 9,
      "text": "前往加纳村酒吧与寻找柠檬的助手（17.3）对话，交出任意1件玩家制作的Lv.6武器获得【柠檬】",
      "type": "exchange-row",
      "sourceLines": [
        9
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "购买6个【砂糖】（维诺亚村村长的家出售）",
      "type": "item-source",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 11,
      "text": "3.集齐相关物品后返回里谢里雅堡与蛋糕师库洛斯对话，交出【蛋糕的配方】及相关物品获得【结晶获取指南】。",
      "type": "exchange-step",
      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "4.前往阿巴尼斯村酒吧与莱特对话，交出【结晶获取指南】获得【勇气考验】。",
      "type": "exchange-step",
      "sourceLines": [
        12
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 13,
      "text": "5.前往米内葛尔岛，击倒伊瓦希米兹后与韦迪对话，交出【勇气考验】获得【祝福的结晶】。",
      "type": "battle-exchange",
      "sourceLines": [
        13
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 14,
      "text": "◆伊瓦希米兹详见《商队的袭击》任务（八等勋章）",
      "type": "reference",
      "sourceLines": [
        14
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 15,
      "text": "◆击倒伊瓦希米兹后先和韦迪对话兑换【祝福的结晶】；若先与伊瓦希米兹对话，对话结束后会传送出去导致无法对话道具",
      "type": "ordering-warning",
      "sourceLines": [
        15
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 16,
      "text": "6. 返回法兰城里谢里雅堡与蛋糕师库洛斯对话，交出【祝福的结晶】随机获得【幸福的蛋糕】、【美味的蛋糕】、【祝福的蛋糕】中任意一个。",
      "type": "random-reward-step",
      "sourceLines": [
        16
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 17,
      "text": "◆【幸福的蛋糕】、【美味的蛋糕】、【祝福的蛋糕】皆可交易",
      "type": "item-detail",
      "sourceLines": [
        17
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 18,
      "text": "7.与里谢里雅堡谒见之间国王对话，交出【幸福的蛋糕】、【美味的蛋糕】或【祝福的蛋糕】获得对应奖品，任务完结。",
      "type": "final-exchange",
      "sourceLines": [
        18
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 19,
      "text": "◆【幸福的蛋糕】可兑换【神圣手环】（不可交易、丢地、存银行），装备后获得称号“幸福的缔造者”",
      "type": "exchange-row",
      "sourceLines": [
        19
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 20,
      "text": "◆【美味的蛋糕】可兑换【阳光耳饰】（不可交易、丢地、存银行），装备后获得称号“享受生活的人”",
      "type": "exchange-row",
      "sourceLines": [
        20
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 21,
      "text": "◆【祝福的蛋糕】可兑换【永恒之链】（不可交易、丢地、存银行），装备后获得称号“永远的魔力宝贝”",
      "type": "exchange-row",
      "sourceLines": [
        21
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    }
  ],
