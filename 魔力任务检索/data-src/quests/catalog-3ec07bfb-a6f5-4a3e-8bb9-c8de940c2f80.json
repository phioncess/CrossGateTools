      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 19,
      "text": "Lv.5项链，来源任务：罪2《贪婪之心》；可交易",
      "type": "reference-item-detail",
      "sourceLines": [
        19
