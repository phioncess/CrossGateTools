  "segments": [
    {
      "line": 1,
      "text": "1.出法兰城西门前往魔女之家附近（289.143）区域寻找随机出现的黄色传送水晶，进入后抵达黑暗医生的巢穴。",
      "type": "maze-entry",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "◆黑暗医生的巢穴为随机迷宫，随机4-8层",
      "type": "maze-detail",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "迷宫刷新时间：4小时（仅供参考），地图大小范围：50*50~100*100；宝箱数量：有",
      "type": "maze-metadata",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "迷宫内的魔物：Lv.6~9的僵尸、大蝙蝠，最高遇敌数量4",
      "type": "encounter-area",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "2.在迷宫内收集4种任务道具：【实验药】、【绷带】、【白衣？】、【急救箱？】（顺序不限、皆不可交易）。",
      "type": "collection-overview",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "⑴洞窟内共有三只随机出现的NPC腐尸，其中两只分别掉落【实验药】、【绷带】，还有一只不掉落道具；",
      "type": "npc-drop-rule",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "队内随机掉落1个任务道具，刷新时间约2分钟；NPC：腐尸Lv.6~11",
      "type": "npc-drop-rule",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "⑵与随机出现的无照护士米内鲁帕对话，输入“荷洛”，获得【白衣？】，",
      "type": "password-acquisition",
      "sourceLines": [
        8
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 9,
      "text": "输入错误会交出10G。注意：需持有10G以上金钱并注意物品栏留空",
      "type": "failure-cost",
      "sourceLines": [
        9
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "⑶与迷宫底层密医阿鲁巴斯（15.14）对话，输入“波罗米亚”获得【急救箱？】，",
      "type": "password-acquisition",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 11,
      "text": "输入错误会交出10G。注意：需持有10G以上金钱并注意物品栏留空",
      "type": "failure-cost",
      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "3.寻找迷宫内随机出现的庸医奈比尔并与之对话，交出【实验药】、【绷带】、【白衣？】、【急救箱？】获得【医生推荐信】。",
      "type": "combined-exchange",
      "sourceLines": [
        12
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 13,
      "text": "4.返回法兰城城东医院（211.83），持有【医生推荐信】与医生天瓶（16.8）对话即可就职，任务完结。",
      "type": "career-completion",
      "sourceLines": [
        13
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 14,
      "text": "◆治疗：前往法兰城城西医院（82.84）与舒柏医生（10.5）对话可学习技能治疗，费用100G，技能格数2",
      "type": "skill-learning",
      "sourceLines": [
        14
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 15,
      "text": "◆与法兰城东医院内实习生塔欧（11.6）对话可获得【医学全书】，该道具可反复拿取",
      "type": "repeatable-acquisition",
      "sourceLines": [
        15
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 16,
      "text": "【医学全书】：Lv.1，种类：护身符；耐久800；不可交易",
      "type": "equipment-detail",
      "sourceLines": [
        16
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 17,
      "text": "使治疗的成功率上升，限医师有用；道具服几率有削弱",
      "type": "version-effect",
      "sourceLines": [
        17
      ],
