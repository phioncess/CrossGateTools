  "segments": [
    {
      "line": 1,
      "text": "1.前往法兰城与露塔（95.83）对话，获得【破旧的纸条】。",
      "type": "item-acquisition",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "2.前往哈贝鲁村与桑德（44.47）对话，交出【破旧的纸条】获得【桑德的指引】。",
      "type": "exchange-step",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "◆哈贝鲁村抵达方式参考《索奇亚古文明调查》任务",
      "type": "route-reference",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "3.前往索奇亚岛（400.254）处，白天持有【神眼】调查破败的石碑，交出【神眼】、【桑德的指引】传送至过去的柯马特依村。",
      "type": "day-party-exchange",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "◆破败的石碑位于角笛大风洞外近加纳村一侧",
      "type": "location-note",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "◆每名队员都需要持有【神眼】；可通过击倒角笛大风洞内的水蜘蛛获得，不可交易",
      "type": "item-source",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "4.与里克（49.56）对话，传送至残破的牢房。",
      "type": "teleport-step",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "5.与克劳姆（36.20）对话进行选择。",
      "type": "route-choice",
      "sourceLines": [
        8
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 9,
      "text": "◆此处选择“是”与“否”直接决定后续路线，请队伍中的所有成员务必协商好做出相同选择，否则后续任务无法一起进行。",
      "type": "party-choice-warning",
      "sourceLines": [
        9
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "◆若队伍成员中有任何一人选择“否”，则整队进入战斗；若队伍成员选择“是”，则该成员单独传送至诺斯菲拉特",
      "type": "choice-resolution",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 11,
      "text": "◆任务剧情：参考《黑与白的漩涡系列任务剧情对话》",
      "type": "story-reference",
      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "◇砍龙练级野队推荐白路线，方便传送",
      "type": "route-recommendation",
      "sourceLines": [
        12
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 13,
      "text": "【白之契】路线：",
      "type": "route-heading",
      "sourceLines": [
        13
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 14,
      "text": "①.选“否”进入战斗。",
      "type": "route-battle-choice",
      "sourceLines": [
        14
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
