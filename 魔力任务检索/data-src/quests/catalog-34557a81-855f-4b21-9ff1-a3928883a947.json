    "rawLines": [
      {
        "line": 1,
        "text": "1.前往亚诺曼城与金秋礼盒贩售员（137.137）对话，可交出800G购买【金秋大乐透礼包】。"
      },
      {
        "line": 2,
        "text": "2.双击【金秋大乐透礼包】可随机获得【奖品】，活动完结。"
      },
      {
        "line": 3,
        "text": "◆在2、3线购买【金秋大乐透礼包】时谨防与NPC位置重叠的“骗子”摊位"
      },
      {
        "line": 4,
        "text": "◆【奖品】明细："
      },
      {
        "line": 5,
        "text": "宠物类"
      },
      {
        "line": 6,
        "text": "原罪之魔精华招财猫精华"
      },
      {
        "line": 7,
        "text": "围巾兔精华圣诞精灵精华"
      },
      {
        "line": 8,
        "text": "其他奖品"
      },
      {
        "line": 9,
        "text": "Lv.8各色宝石哥拉尔镇/阿凯鲁法村/雷克塔尔镇/流星山丘传送券"
      },
      {
        "line": 10,
        "text": "鼠王惊奇蛋阿尔卡迪亚古钱"
      },
      {
        "line": 11,
        "text": "超神药草（500技能经验）技能学习证（双子服无此奖品）"
      }
    ]
  },
