  "segments": [
    {
      "line": 1,
      "text": "1.前往法兰城王宫食堂（111.148）与培里．贝肯（15.7）对话。",
      "type": "npc-step",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "2.交出几种符合时间限制的【料理】其一，获得称号“敏腕厨师”、【味精】，若时间不对会得到称号“不合格厨师”。",
      "type": "conditional-title-reward",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "◆料理明细与时间限制：",
      "type": "table-heading",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "料理时间（分）",
      "type": "table-heading",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "蛋包饭1~2",
      "type": "timed-dish-row",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "亲子丼1~3",
      "type": "timed-dish-row",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "寿喜锅10~15",
      "type": "timed-dish-row",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "魅惑的哈密瓜面包2~7",
      "type": "timed-dish-row",
      "sourceLines": [
        8
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 9,
      "text": "醋饭寿司5~7",
      "type": "timed-dish-row",
      "sourceLines": [
        9
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "鳖料理1~2",
      "type": "timed-dish-row",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 11,
      "text": "鱼翅汤2~3",
      "type": "timed-dish-row",
      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "3.拥有“敏腕厨师”称号、持有【白熊肉排】交出后，交出称号“敏腕厨师”获得称号“极上厨师”。",
      "type": "title-upgrade",
      "sourceLines": [
        12
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 13,
      "text": "◆【白熊肉排】获得方式参考《积雪的山路》任务，可交易；【白熊肉排】无时间限制",
      "type": "item-source",
      "sourceLines": [
        13
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 14,
      "text": "4.拥有“极上厨师”称号，",
      "type": "title-gate",
      "sourceLines": [
        14
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 15,
      "text": "持有做出时间刚在1440~1445分钟内的【咖哩饭】交出后，交出称号“极上厨师”获得称号“究极厨师”、【万能料理组】。",
      "type": "title-upgrade",
      "sourceLines": [
        15
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 16,
      "text": "◆【万能料理组】：Lv.3戒指、耐久60~80；装备后料理耗魔减少10%，每次使用减少1点耐久；不可交易",
      "type": "reward-detail",
      "sourceLines": [
        16
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 17,
      "text": "◆拥有“敏腕厨师”或“极上厨师”称号时，交给培里·贝肯（15.7）【料理】后随机获得【味精】【万能料理组】。",
      "type": "title-random-reward",
      "sourceLines": [
        17
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 18,
      "text": "◆【味精】亦可用【番茄】与培里·贝肯（15.7）兑换，比例为1:1",
      "type": "exchange-recipe",
      "sourceLines": [
        18
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 19,
      "text": "◆【味精】：不可交易",
      "type": "item-detail",
      "sourceLines": [
        19
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 20,
      "text": "制作任意料理时，若配方中加入【味精】，在使用时可多补充10点魔力",
      "type": "item-effect",
      "sourceLines": [
        20
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 21,
      "text": "【味精】小贴士：",
      "type": "tips-heading",
      "sourceLines": [
        21
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 22,
      "text": "⑴将未添加【味精】的【普通料理】叠加在同类【味精料理】上，【普通料理】会变成【味精料理】",
      "type": "stacking-rule",
      "sourceLines": [
        22
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 23,
      "text": "⑵将【味精料理】叠加在同类【普通料理】上，则【味精料理】会变成【普通料理】",
      "type": "stacking-rule",
      "sourceLines": [
        23
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 24,
      "text": "◆称号“不合格厨师”路线：",
      "type": "failure-heading",
      "sourceLines": [
        24
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 25,
      "text": "⑴如果做出【料理】后超过一定时间交给培里·贝肯，获得称号“不合格厨师”",
      "type": "failure-route",
      "sourceLines": [
        25
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 26,
      "text": "⑵将做出时间超过一天后的【面包】交给培里·里肯，获得称号“不合格厨师”",
      "type": "failure-route",
      "sourceLines": [
        26
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 27,
      "text": "⑶将NPC处购买的【糖果】交给培里·里肯，获得称号“不合格厨师”",
      "type": "failure-route",
      "sourceLines": [
        27
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 28,
      "text": "NPC：法兰城-陶欧食品店（72.104），塔妮雅（18.7）",
      "type": "shop-source",
      "sourceLines": [
        28
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    }
  ],
