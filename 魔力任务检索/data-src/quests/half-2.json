      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "3.等待约10分钟后与守信用的水手对话，交出【止吐药】传送至小岛。",
      "type": "timed-exchange",
      "sourceLines": [
