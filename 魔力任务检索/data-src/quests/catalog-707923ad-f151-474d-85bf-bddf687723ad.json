      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "魔物为Lv60~64的地龙蜥、水龙蜥、火龙蜥、风龙蜥、蜥蜴战士、猎豹蜥蜴、蜥蜴武士、蜥蜴斗士，最高遇敌数量10",
      "type": "maze-encounter",
      "sourceLines": [
        12
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 13,
      "text": "◆遇敌会随机触发多次连战；迷宫重置后会根据入口楼层传送至1楼、10楼、20楼或30楼",
      "type": "multi-battle-rule",
      "sourceLines": [
        13
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 14,
      "text": "5.在询问之地10楼、20楼、30楼询问处分别与生病的人、虫群或被征召者、杀人者或治理者对话，进行选择。",
      "type": "question-step",
      "sourceLines": [
        14
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 15,
      "text": "◆全部选项皆选“是”，获得【白之意志】",
      "type": "choice-result",
      "sourceLines": [
