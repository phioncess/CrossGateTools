      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 16,
      "text": "◆全部选项以“否”、“是”、“否”选择，获得【黑之意志】",
      "type": "choice-result",
      "sourceLines": [
