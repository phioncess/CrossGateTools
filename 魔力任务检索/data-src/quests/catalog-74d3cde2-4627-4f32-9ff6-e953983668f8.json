  "segments": [
    {
      "line": 1,
      "text": "1.前往法兰城安其摩酒吧（102.131）与酩酊大醉的男人（9.20）对话。（此步可跳过）",
      "type": "optional-step",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "2.与酒店主人（21.12）对话，获得【酒店主人的委托】。",
      "type": "item-acquisition",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "3.前往法兰城大圣堂（154.29），由（23.14）进入后台与僧侣特伦（37.26）对话，交出【酒店主人的委托】获得【老师的信】。",
      "type": "exchange-step",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "4.前往哈巴鲁东边洞穴地下二楼与修女琳达（22.7）对话，交出【老师的信】获得【药草囊】。",
      "type": "exchange-step",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "◆修女琳达在“熊男”杀熊者欧兹那克后面；相关《杀熊者欧兹那克》",
      "type": "route-reference",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "5.前往法兰城大圣堂（154.29），由（23.14）进入后台与僧侣特伦（37.26）对话，交出【药草囊】获得【醒酒药汤】。",
      "type": "exchange-step",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "6.前往法兰城安其摩酒吧（102.131）与酩酊大醉的男人（9.20）对话，交出【醒酒药汤】获得【玛莎的照片】。",
      "type": "exchange-step",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "7.前往圣拉鲁卡村与村长萨巴普对话。（此步可跳过）",
