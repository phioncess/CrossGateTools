  "segments": [
    {
      "line": 1,
      "text": "完成《丧失心智的海盗》任务",
      "type": "prerequisite",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "拥有“野狼勇士”称号",
      "type": "title-gate",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "1.前往蒂娜村，出村南门至莎莲娜岛（591.331）处与老渔民对话，选“是”传送至蒂娜海底。",
      "type": "teleport-step",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "2.通过蒂娜海底抵达沉船，与副手乔治（27.23）对话，获得【黄色三棱石】。",
      "type": "item-acquisition",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "3.前往蒂娜村外东方调查树木（676.321），进入海盗暗道。",
      "type": "maze-entry",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "4.通过随机迷宫抵达暗道底层外部，调查门传送至暗道底层内部。",
      "type": "maze-route",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "5.与海盗？对话进入战斗。",
      "type": "battle-step",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "6.战斗胜利后与贝拉米的舵手对话，获得【奇怪的粘稠物】。",
      "type": "item-acquisition",
      "sourceLines": [
        8
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 9,
      "text": "7.返回法兰城，前往冒险者旅馆1楼与大侦探汉克对话。（此步可跳过）",
      "type": "optional-step",
      "sourceLines": [
        9
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "8.前往里谢里雅堡2楼图书馆与元素专家耐罗恩对话，交出【奇怪的粘稠物】获得【粘稠物成份报告】。",
      "type": "exchange-step",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 11,
      "text": "9.返回冒险者旅馆1楼与大侦探汉克对话。（此步可跳过）",
      "type": "optional-step",
      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "10.前往法兰城（278.82）处与李林对话，交出【粘稠物成份报告】获得【绿色三棱石】。",
      "type": "exchange-step",
      "sourceLines": [
        12
