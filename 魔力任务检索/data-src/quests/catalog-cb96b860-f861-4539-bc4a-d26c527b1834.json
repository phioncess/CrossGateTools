  "segments": [
    {
      "line": 1,
      "text": "1.前往斯特隆海姆城议事厅（34.34）2楼与管理官（18.6）对话，获得【委托信】。",
      "type": "step",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "2.前往斯特隆海姆城（63.32）处与矿山小镇联络员对话，交出【委托信】获得【委托证件】。",
      "type": "exchange-step",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "3.前往雷克亚克平原（269.45）处，持有【委托证件】与卫兵对话，进入矿山小镇莫利亚。",
      "type": "access-step",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "◆卫兵位于雷克亚克平原东北方向",
      "type": "location-note",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "◆【委托证件】不会交出。做到此步即可烧技能，魔物为Lv.55~57哥布林*1~3，技能：攻击、防御、崩击、炎阳",
      "type": "access-and-training-note",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "◆矿山小镇医院内有资深护士，小镇商店（58.55）凌晨可原价贩卖魔石",
      "type": "service-note",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "4.前往镇长的家（30.29）与镇长（60.81）对话，交出【委托证件】获得【村长的委托书】。",
      "type": "exchange-step",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "5.前往矿山小镇莫利亚（41.23）处与自警团团长对话，交出【村长的委托书】获得【应急包裹】。",
      "type": "exchange-step",
      "sourceLines": [
        8
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 9,
      "text": "6.前往矿山小镇莫利亚（41.21）处进入莫利亚坑道，前往（47.6）处进入阴森的矿路。",
      "type": "maze-entry",
      "sourceLines": [
        9
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "◆阴森的矿路为随机迷宫，共5层；魔物为Lv.54~58红蝎、土蜘蛛",
      "type": "encounter-area",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 11,
      "text": "7.通过随机迷宫抵达莫利亚矿区，通过（21.25）处进入崩落的通道。",
      "type": "route-step",
      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "8.前往（28.8）处切换地图，调查（7.11）处巨石，交出【应急包裹】获得【副队长的笔记】。",
      "type": "exchange-step",
      "sourceLines": [
        12
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 13,
      "text": "9.前往（29.3）处进入古老的深渊裂口。",
      "type": "maze-entry",
      "sourceLines": [
        13
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 14,
      "text": "◆古老的深渊裂口为随机迷宫，共9层；魔物为Lv.59~64血骷髅、布丁史莱姆",
      "type": "encounter-and-random-boss",
      "sourceLines": [
        14
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 15,
      "text": "◆古老的深渊裂口内会随机遭遇BOSS战；游荡的永恒之魂，血量约7000，技能：攻击、防御、装备破坏、偷钱、经验吸收",
      "type": "random-boss-detail",
      "sourceLines": [
        15
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 16,
      "text": "10.通过随机迷宫抵达盟约圣殿，调查（7.39）处切换场景，调查（48.39）处水晶石，进入战斗。",
      "type": "battle-step",
      "sourceLines": [
        16
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 17,
      "text": "◆战斗信息：",
      "type": "battle-heading",
      "sourceLines": [
        17
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 18,
      "text": "Lv.70蛇神阿波菲斯，血量约15000；技能：攻击、防御、冰冻魔法、吸血魔法、强力陨石魔法、混乱魔法",
      "type": "battle-enemy",
      "sourceLines": [
        18
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 19,
      "text": "Lv.70地龙蜥*5，血量约1500；技能：攻击、防御、诸刃、战栗袭心",
      "type": "battle-enemy",
      "sourceLines": [
        19
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 20,
      "text": "11.战斗胜利后与格罗克.寒铁（55.6）对话，交出【副队长的笔记】获得【队长的说明信】并传送至莫利亚坑道。",
      "type": "exchange-step",
      "sourceLines": [
        20
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 21,
      "text": "12.返回矿山小镇莫利亚镇长的家与镇长（60.81）对话，交出【队长的说明信】，任务完结。",
      "type": "completion-step",
      "sourceLines": [
        21
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 22,
      "text": "◆完成任务后，无需【委托证件】亦可与卫兵对话进入矿山小镇莫利亚",
      "type": "post-completion-access",
      "sourceLines": [
        22
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    }
  ],
