    "rawLines": [
      {
        "line": 1,
        "text": "1.前往亚诺曼城与红魔礼包贩售员（131.131）对话，交出1000G购买【红魔礼包】。"
      },
      {
        "line": 2,
        "text": "◆在2、3线购买【蓝魔礼包】时谨防与NPC位置重叠的“骗子”摊位"
      },
      {
        "line": 3,
        "text": "2.双击【红魔礼包】随机获得【奖品】，任务完结。"
      },
      {
        "line": 4,
        "text": "◆【奖品】明细："
      },
      {
        "line": 5,
        "text": "宠物类奖品（随机获得）备注"
      },
      {
        "line": 6,
        "text": "红魔乔卡之卵天之纹章红魔乔卡；10技能栏、飞行系火100；34 44 15 22 10"
      },
      {
        "line": 7,
        "text": "无之纹章红魔乔卡；10技能栏、飞行系水20火80；25 8 28 20 44"
      },
      {
        "line": 8,
        "text": "迷你龙设计图（A~E）天真的迷你龙；9技能栏、龙系地30水70；36 40 20 18 11"
      },
      {
        "line": 9,
        "text": "人魔草设计图（A~E）极冰之人魔草；9技能栏、植物系水90火10；20 12 24 25 44"
      },
      {
        "line": 10,
        "text": "其他奖品（随机获得）"
      },
      {
        "line": 11,
        "text": "鼠王惊奇蛋鼠王还原券"
      },
      {
        "line": 12,
        "text": "技能学习证魔石"
      },
      {
        "line": 13,
        "text": "哥拉尔镇/阿凯鲁法村/雷克塔尔镇传送券传送石优待券"
      },
      {
        "line": 14,
        "text": "神奇的药草（200技能经验）Lv.9各色宝石"
      }
    ]
  },
