  "segments": [
    {
      "line": 1,
      "text": "1.前往法兰城里谢里雅堡名人堂(52.61)与工程人员（11.9）对话至二楼。",
      "type": "route-step",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "2.前往二楼（16.49）处房间，持有【探险队戒指】与高级研究员（12.82）对话，交出【探险队戒指】获得【商船乘坐信】、【祭祀器具包裹】。",
      "type": "combined-exchange",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "◆【探险队戒指】获得方式参考《遗迹探险队》任务",
      "type": "item-source",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "3.前往伊尔村港湾管理处与商船船长（13.12）对话，选“是”交出【商船乘坐信】获得【船票】并传送至坎普号补给船。",
      "type": "boarding-step",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "4.等待三分钟后与商船船长（44.22）对话，进入战斗。",
      "type": "timed-battle-step",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "◆战斗信息：（中间为BOSS）",
      "type": "battle-heading",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "Lv.50疯狂的鸟人，血量约5000；技能：攻击、防御、连击、崩击、战栗袭心",
      "type": "battle-enemy",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "Lv.50疯狂的鸟人*4，血量约800；技能：攻击、防御、连击、崩击、战栗袭心",
      "type": "battle-enemy",
      "sourceLines": [
        8
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 9,
      "text": "5.战斗胜利后传送之荒岛码头，与商船船长（34.22）对话，交出【船票】进入荒岛探险团营地。",
      "type": "travel-step",
      "sourceLines": [
        9
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "6.与探险团团长（57.39）对话，选“是”交出【祭祀器具包裹】获得【复制祭祀器】。",
      "type": "exchange-step",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 11,
      "text": "7.与营地守卫（64.28）对话，进入祭祀迷宫入口。通过（26.20）处楼梯抵达祭祀迷宫。",
      "type": "maze-entry",
      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "◆祭祀迷宫为随机迷宫，约7层；魔物为Lv.49~52灰翼蝙蝠（大蝙蝠）、无名的亡者（僵尸）、邪能软泥怪（史莱姆）",
      "type": "encounter-area",
      "sourceLines": [
        12
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 13,
      "text": "8.通过随机迷宫抵达祭坛与祭祀之灵（15.9）对话，进入战斗,迷宫约7层。",
      "type": "battle-step",
      "sourceLines": [
        13
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 14,
      "text": "◆战斗信息：",
      "type": "battle-heading",
      "sourceLines": [
        14
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 15,
      "text": "Lv.55祭祀之灵，血量约10000；技能：攻击、防御、战栗袭心、石化魔法、混乱魔法",
      "type": "battle-enemy",
      "sourceLines": [
        15
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 16,
      "text": "Lv.55祭祀之刃*4，血量约800；技能：攻击、防御",
      "type": "battle-enemy",
      "sourceLines": [
        16
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 17,
      "text": "9.战斗胜利后调查祭台（15.5），交出【复制祭祀器】获得【奇异的宝石】并传送至祭祀迷宫入口。",
      "type": "exchange-step",
      "sourceLines": [
        17
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 18,
      "text": "10.与营地守卫（22.18）对话，选“是”进入荒岛探险团营地。",
      "type": "route-step",
      "sourceLines": [
        18
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 19,
      "text": "11.与探险团团长对话，交出【奇异的宝石】获得【封印包裹】。",
      "type": "exchange-step",
      "sourceLines": [
        19
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 20,
      "text": "12.返回法兰城里谢里雅堡名人堂二楼房间（16.49）与高级研究员（12.82）对话，交出【封印包裹】获得【初级探险队戒指】，任务完结。",
      "type": "completion-step",
      "sourceLines": [
        20
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 21,
      "text": "◆【初级探险队戒指】：Lv.1戒指、耐久100；魅力+5；丢地消失",
      "type": "reward-detail",
      "sourceLines": [
        21
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 22,
      "text": "◆【初级探险队戒指】为后续任务道具，不可丢弃",
      "type": "future-use",
      "sourceLines": [
        22
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 23,
      "text": "◆任务剧情：参考《失落的炼金术系列任务剧情对话》",
      "type": "story-reference",
      "sourceLines": [
        23
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    }
  ],
