  "segments": [
    {
      "line": 1,
      "text": "1.前往杰诺瓦镇医院（44.33）2楼与神官比尔班（11.4）对话，每名队员，获得【贝兹雷姆之钥】。",
      "type": "item-acquisition",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "◆职业需达到1转（正职阶段）及以上才可获得",
      "type": "career-gate",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "◆护士、医生和战斗系晋阶任务一致，需完成本任务获得晋级资格",
      "type": "promotion-scope",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "◆杰诺瓦镇到达方法：参考本文最后的小贴士",
      "type": "travel-reference",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "2.出杰诺瓦镇西门（24.41），前往莎莲娜岛（135.333）处与神官杰拉娜对话，交出【贝兹雷姆之钥】传送至入口。",
      "type": "item-teleport",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "3.通过黄色传送石（25.7）进入贝兹雷姆的迷宫。在贝兹雷姆的迷宫内，每名队员击倒大地翼龙收集【地龙的鳞片】。",
      "type": "maze-entry",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "◆贝兹雷姆的迷宫为随机迷宫，约12层；迷宫刷新时间：4小时。",
      "type": "maze-detail",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "地图大小范围：60*60~80*80；宝箱数量：6。（仅供参考）",
      "type": "maze-detail",
      "sourceLines": [
        8
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 9,
      "text": "魔物为Lv.34~36大炸弹、大地翼龙：",
      "type": "encounter-heading",
      "sourceLines": [
        9
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "大炸弹，HP≈500，属性：火80风20，特殊系，",
      "type": "encounter-detail",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 11,
      "text": "技能：攻击、防御、强力火焰魔法、自爆（血量<50%时追加）、自爆（血量<25%时追加）、自爆（全体伤害，超过2个玩家时追加）",
      "type": "encounter-skills",
      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "大地翼龙，HP≈800，属性：地100，龙系，技能：攻击、防御、毒性攻击、装备破坏（超过2个玩家时追加）",
      "type": "encounter-detail",
      "sourceLines": [
        12
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 13,
      "text": "◆迷宫内队伍人数若超过2人，魔物会追加装备破坏、自爆（全体伤害）",
      "type": "party-size-rule",
      "sourceLines": [
        13
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 14,
      "text": "◆迷宫掉落物品：",
      "type": "drop-heading",
      "sourceLines": [
        14
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 15,
      "text": "击倒大地翼龙会随机获得【地龙的鳞片】，全域魔物随机掉落【誓言之证】。",
      "type": "drop-rule",
      "sourceLines": [
        15
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 16,
      "text": "【地龙的鳞片】：注销时会消失、不可交易、丢地消失、无法使用宠物邮件。",
      "type": "item-lifecycle",
      "sourceLines": [
        16
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 17,
      "text": "【誓言之证】：可用于高等级装备合成的材料。",
      "type": "item-use",
      "sourceLines": [
        17
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 18,
      "text": "4.通过随机迷宫最底层抵达静谧之间，每名队员持有【地龙的鳞片】与神官葛雷森（26.67）对话，选“是”交出【地龙的鳞片】并单人通过栅栏。",
      "type": "solo-gate",
      "sourceLines": [
        18
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 19,
      "text": "5.与神兽史雷普尼尔（26.25）对话进入战斗。",
      "type": "battle-step",
      "sourceLines": [
        19
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
