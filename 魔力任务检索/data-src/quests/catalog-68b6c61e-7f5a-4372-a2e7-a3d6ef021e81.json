  "name": "要塞中的恶梦",
  "aliases": [
    "改恶梦"
  ],
  "metadata": {
    "category": "临时活动/任务",
    "level": "50 级",
    "availability": "closed",
    "summary": "怀旧服任务（已关闭）；以下仅展示怀旧服路线与参数",
