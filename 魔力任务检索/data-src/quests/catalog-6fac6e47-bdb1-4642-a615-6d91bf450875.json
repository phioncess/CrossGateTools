      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 18,
      "text": "5.返回里谢里雅堡（48.57）天文大臣对话，交出【咨询结果】，获得【通灵护符】。",
      "type": "exchange-step",
      "sourceLines": [
        18
