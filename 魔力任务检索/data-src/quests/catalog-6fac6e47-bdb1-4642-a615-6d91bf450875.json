  },
  "source": {
    "key": "catalog_6fac6e47-bdb1-4642-a615-6d91bf450875",
    "url": "https://www.molibaike.com/Mission/Detail/6fac6e47-bdb1-4642-a615-6d91bf450875?u=True",
    "localFiles": [],
    "lineCount": 39,
    "rawLines": [
      {
        "line": 1,
        "text": "分支一：抽奖"
      },
      {
        "line": 2,
        "text": "1.法兰城，里谢里雅堡（48.60）元宵节商贩，1000魔币购买【元宵礼包】。（道具服100魔币）。"
      },
      {
        "line": 3,
        "text": "2.双击【元宵礼包】，随机获得4种奖品其一。"
      },
      {
        "line": 4,
        "text": "奖品："
      },
      {
        "line": 5,
        "text": "小碗元宵、小碗汤圆、大碗元宵、大碗汤圆。（可交易、丢地；3个一组）"
      },
      {
        "line": 6,
        "text": "奖励信息："
      },
      {
        "line": 7,
        "text": "小碗元宵：Lv.1，食物；回复100点生命值；"
      },
      {
        "line": 8,
        "text": "小碗汤圆：Lv.1，食物；回复100点魔法值；（无冷却时间）"
      },
      {
        "line": 9,
        "text": "大碗元宵：Lv.2，食物；回复200点生命值；"
      },
      {
        "line": 10,
        "text": "大碗汤圆：Lv.2，食物；回复150点魔法值；（无冷却时间）"
      },
      {
        "line": 11,
        "text": "油炸元宝：Lv.5，食物；回复250点魔法值；（无冷却时间）"
      },
      {
        "line": 12,
        "text": "分支二：战斗"
      },
      {
        "line": 13,
        "text": "1.里谢里雅堡（48.57）天文大臣对话选是拿【占卜信】。"
      },
      {
        "line": 14,
        "text": "2.白天，魔法大学（64.122）流浪占卜师对话，选“是”交出100魔币、【占卜信】，获得【占卜结果】。"
      },
      {
        "line": 15,
        "text": "3.里谢里雅堡（48.57）天文大臣对话。交出【占卜结果】获得【咨询信】。"
      },
      {
        "line": 16,
        "text": "4.夜晚，到魔法大学（64.122）流浪占卜师对话，说“占卜...”，交出【咨询信】，获得【咨询结果】。"
      },
      {
        "line": 17,
        "text": "◇这一步似乎说啥都行，但必须结尾加上“...”"
      },
      {
        "line": 18,
        "text": "5.返回里谢里雅堡（48.57）天文大臣对话，交出【咨询结果】，获得【通灵护符】。"
      },
      {
        "line": 19,
        "text": "◆Lv.50以下的人物获得【小勋章】和【元宵礼包】。不会获得【通灵护符】。"
      },
      {
        "line": 20,
        "text": "◆持有【小勋章】，每23小时领取1次奖励（【元宵礼包】）"
      },
      {
        "line": 21,
        "text": "6.米诺基亚村东方561.844进入迷宫（火属性），约5层到达最底层，"
      },
      {
        "line": 22,
        "text": "击倒赤衣神君，交出【通灵护符】获得【避火水晶】。"
      },
      {
        "line": 23,
        "text": "7.返回里谢里雅堡（48.57）天文大臣对话，获得【大勋章】和【元宵大礼包】、【上元使者徽章】。"
      },
      {
        "line": 24,
        "text": "◆持有【大勋章】，每23小时领取1次奖励（【元宵大礼包】）"
      },
      {
        "line": 25,
        "text": "【元宵大礼包】：双击【元宵大礼包】，随机获得5种奖品其二。（猜测未实测）"
      },
      {
        "line": 26,
        "text": "奖品：小碗元宵、小碗汤圆、大碗元宵、大碗汤圆、油炸元宝。（可交易、丢地；3个一组）"
      },
      {
        "line": 27,
        "text": "【上元使者徽章】：装备后称号“上元使者”；"
      },
      {
        "line": 28,
        "text": "Lv.1，护身符，耐久138；精神+2，必杀+2，生命+100，魔力+55；不可交易"
      },
      {
        "line": 29,
        "text": "◇小贴士： 前往米诺基亚村方法"
      },
      {
        "line": 30,
        "text": "①.哥拉尔镇→米诺基亚村（前提：已经开过传送石）"
      },
      {
        "line": 31,
        "text": "哥拉尔镇传送至米诺基亚村的传送石："
      },
      {
        "line": 32,
        "text": "位于哥拉尔镇-白之宫殿内向南走至（24.70）下楼梯后的启程之间内。"
      },
      {
        "line": 33,
        "text": "②.哥拉尔镇→鲁米那斯村→米诺基亚村："
      },
      {
        "line": 34,
        "text": "1.哥拉尔镇→鲁米那斯村"
      },
      {
        "line": 35,
        "text": "2.鲁米那斯村→米诺基亚村："
      },
      {
        "line": 36,
        "text": "由库鲁克斯岛（318，822），经伊利斯矿山到达米诺基亚村（433，824）；"
      },
      {
        "line": 37,
        "text": "参考《伊利斯矿山》、《库鲁克斯岛》地图"
      },
      {
        "line": 38,
        "text": "③.雷克塔尔镇→米诺基亚村："
      },
      {
        "line": 39,
        "text": "（怀旧服）推荐使用【雷克塔尔传送券】（单人；限制Lv.40）传送至雷克塔尔镇"
      }
    ]
  },
