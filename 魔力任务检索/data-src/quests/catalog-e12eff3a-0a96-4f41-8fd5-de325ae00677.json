    "lineCount": 14,
    "rawLines": [
      {
        "line": 1,
        "text": "1.前往亚诺曼城与翠绿礼包贩售员（131.131）对话，交出1000G购买【翠绿礼包】。"
      },
      {
        "line": 2,
        "text": "◆在2、3线购买【翠绿礼包】时谨防与NPC位置重叠的“骗子”摊位"
      },
      {
        "line": 3,
        "text": "2.双击【翠绿礼包】随机获得【奖品】，任务完结。"
      },
      {
        "line": 4,
        "text": "◆【奖品】明细："
      },
      {
        "line": 5,
        "text": "宠物类奖品（随机获得）备注"
      },
      {
        "line": 6,
        "text": "翠绿之卵绿魔诺曼；10技能栏、飞行系地100；37 43 17 20 8"
      },
      {
        "line": 7,
        "text": "绿魔奥斯本；10技能栏、飞行系地60水40；25 6 32 17 45"
      },
      {
        "line": 8,
        "text": "熔岩设计图（A~E）绳状熔岩；9技能栏、金属系火100；38 35 28 12 12"
      },
      {
        "line": 9,
        "text": "翠绿菇设计图（A~E）波尔卡舞蹈菇；9技能栏、植物系地50风50；37 9 15 17 47"
      },
      {
        "line": 10,
        "text": "其他奖品（随机获得）"
      },
      {
        "line": 11,
        "text": "鼠王惊奇蛋鼠王还原券"
      },
      {
        "line": 12,
        "text": "技能学习证魔石"
      },
      {
        "line": 13,
        "text": "哥拉尔镇/阿凯鲁法村/雷克塔尔镇传送券传送石优待券"
      },
      {
        "line": 14,
        "text": "神奇的药草（200技能经验）Lv.9各色宝石"
      }
    ]
  },
