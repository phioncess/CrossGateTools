    "rawLines": [
      {
        "line": 1,
        "text": "1.前往法兰城大圣堂旁与会场引导员（161.29）对话，选“是”进入庆典会场。"
      },
      {
        "line": 2,
        "text": "2.持有7日以上的【结婚戒指】与牧师（44.44）对话，交出【结婚戒指】获得【情比金坚戒】，任务完结。"
      },
      {
        "line": 3,
        "text": "◆【结婚戒指】获得方式参考《凤凰的羽毛》任务"
      },
      {
        "line": 4,
        "text": "◆【情比金坚戒】：Lv.1戒指、耐久100；抗石化+5、必杀+5、命中+5；可交易。"
      },
      {
        "line": 5,
        "text": "装备后获得称号“被幸福包围的人”。"
      }
    ]
  },
