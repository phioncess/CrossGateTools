  "segments": [
    {
      "line": 1,
      "text": "1.前往法兰城与旅行社工读生（160.144）或前往亚诺曼城与亚城艺术研究生（148.131）",
      "type": "optional-source",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "对话，获得【亚城观光指南】。（此步可省略）",
      "type": "optional-item-acquisition",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "2.前往亚诺曼城与月光船夫（203.109）对话，选“是”进入月光花园。",
      "type": "garden-entry",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "◆月光花园内与月光船夫（36.61）对话可传送回亚诺曼城",
      "type": "return-route",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "3.与月光花园管理员（29.46）对话，选“是”获得【SE调查报告】。",
      "type": "task-start",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 6,
      "text": "◆持有【天使的画具】时对话无法接到任务。",
      "type": "inventory-gate",
      "sourceLines": [
        6
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 7,
      "text": "4.调查盖亚之门（50.33），选“是”交出100G获得【地之珠】。",
      "type": "purchase-step",
      "sourceLines": [
        7
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 8,
      "text": "◆4~6步请勿重复放入道具，否则需由第4步重来",
      "type": "failure-warning",
      "sourceLines": [
        8
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 9,
      "text": "5.调查雕像（11.61），选“是”交出【地之珠】获得【水之珠】。",
      "type": "exchange-step",
      "sourceLines": [
        9
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 10,
      "text": "6.调查雕像（53.65），选“是”交出【水之珠】获得【火之珠】。",
      "type": "exchange-step",
      "sourceLines": [
        10
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 11,
      "text": "7.调查雕像（18.31），选“是”交出【火之珠】获得【风之钥】。",
      "type": "exchange-step",
      "sourceLines": [
        11
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 12,
      "text": "8.返回调查盖亚之门（50.33），选“是”交出【风之钥】进入地下密室。",
      "type": "door-entry",
      "sourceLines": [
        12
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 13,
      "text": "9.调查点燃的蜡烛（7.5），选“是”变更场景。",
      "type": "scene-change",
      "sourceLines": [
        13
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 14,
      "text": "调查打火石（31.3）获得【打火石】。（队伍里有一人获得即可）",
      "type": "party-item-acquisition",
      "sourceLines": [
        14
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 15,
      "text": "10.调查壁炉（13.9），选“是”交出【打火石】并变更场景。",
      "type": "exchange-step",
      "sourceLines": [
        15
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 16,
      "text": "与神秘男人（44.30）对话，选“是”获得【储藏室钥匙】。（队伍里有一人获得即可）",
      "type": "party-item-acquisition",
      "sourceLines": [
        16
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 17,
      "text": "11.调查储藏室的门（35.45），交出【储藏室钥匙】进入储藏室。",
      "type": "door-entry",
      "sourceLines": [
        17
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 18,
      "text": "通过黄色传送石（12.6）进入万缕相思结晶路藏爱。",
      "type": "maze-entry",
      "sourceLines": [
        18
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 19,
      "text": "◆万缕相思结晶路藏爱为随机迷宫，约8~10层；魔物为Lv.20~24小恶魔、天使蝙蝠，数量：2~5",
      "type": "encounter-area",
      "sourceLines": [
        19
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 20,
      "text": "12.通过随机迷宫最底层黄色传送石进入画室，",
      "type": "maze-exit",
      "sourceLines": [
        20
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 21,
      "text": "解散队伍，调查深情的肖像（21.10），选“是”获得【深情的肖像画】并传送回地下密室。",
      "type": "solo-item-acquisition",
      "sourceLines": [
        21
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 22,
      "text": "◆调查深情的肖像前先解散队伍，否则其他队员不会获得【深情的肖像画】",
      "type": "solo-warning",
      "sourceLines": [
        22
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 23,
      "text": "13.与神秘男人（43.30）对话交出【深情的肖像画】，变更场景。",
      "type": "exchange-step",
      "sourceLines": [
        23
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 24,
      "text": "调查神秘枯男（45.28），获得【天使的画具】并传送回月光花园，任务完结。",
      "type": "completion-item",
      "sourceLines": [
        24
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 25,
      "text": "◆【天使的画具】：Lv.1护身符、耐久180~240；生命+30~50、魅力+3~5；数值浮动；可以交易",
      "type": "reward-detail",
      "sourceLines": [
        25
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    }
