    "localFiles": [],
    "lineCount": 8,
    "rawLines": [
      {
        "line": 1,
        "text": "1.与法兰城情人节活动专员（233.126）对话。"
      },
      {
        "line": 2,
        "text": "2.持有【流星耳环】时，前往法兰城庆典会场与情人节活动专员（35.25）对话，交出【流星耳环】获得【爱的证明（男）】或【爱的证明（女）】。"
      },
      {
        "line": 3,
        "text": "◆【流星耳环】获得方式参考《流星山丘》任务"
      },
      {
        "line": 4,
        "text": "◆男性角色获得【爱的证明（男）】；女性角色获得【爱的证明（女）】"
      },
      {
        "line": 5,
        "text": "◆【爱的证明（男）/（女）】可交易"
      },
      {
        "line": 6,
        "text": "3.男性角色持有【爱的证明（女）】、女性角色持有【爱的证明（男）】时，与法兰城庆典会场情人节活动专员对话，交出【爱的证明（男）/（女）】获得称号“她的男神”或“他的女神”、【爱情之力】，任务完结。"
      },
      {
        "line": 7,
        "text": "◆男性角色获得称号“她的男神”；女性角色获得称号“他的女神”"
      },
      {
        "line": 8,
        "text": "◆在物品栏内存有多个【流星耳环】，可一次性兑换多个【爱的证明（男）/（女）】"
      }
    ]
  },
