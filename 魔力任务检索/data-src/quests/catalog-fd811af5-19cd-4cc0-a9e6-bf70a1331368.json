      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 26,
      "text": "通过（23.6）处楼梯上楼，返回维诺亚村。",
      "type": "route-step",
      "sourceLines": [
