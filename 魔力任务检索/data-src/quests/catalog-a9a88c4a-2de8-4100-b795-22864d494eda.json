  "segments": [
    {
      "line": 1,
      "text": "1.与法兰城平民武器贩售处（150.122）对话，购买就职职业对应的武器。",
      "type": "weapon-purchase",
      "sourceLines": [
        1
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 2,
      "text": "◆转职：不需装备对应武器，跳过这步骤",
      "type": "transfer-skip",
      "sourceLines": [
        2
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 3,
      "text": "◆职业与对应武器：（怀旧服平民武器，不可以交易）",
      "type": "weapon-table-heading",
      "sourceLines": [
        3
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 4,
      "text": "职业武器价格",
      "type": "table-heading",
      "sourceLines": [
        4
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
      "line": 5,
      "text": "剑士平民剑400G",
      "type": "weapon-row",
      "sourceLines": [
        5
      ],
      "verification": {
        "status": "verified",
        "method": "manual-semantic-review"
      }
    },
    {
